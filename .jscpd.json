{
  "path": [
    "cmd",
    "internal",
    "web/src"
  ],
  "format": [
    "go",
    "typescript",
    "javascript",
    "vue",
    "css"
  ],
  "reporters": [
    "console",
    "json"
  ],
  "minLines": 8,
  "minTokens": 100,
  "threshold": 5,
  "output": "../.quality",
  "mode": "mild",
  "absolute": false,
  "gitignore": true,
  "ignore": [
    "**/.git/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/.dev/**",
    "**/bin/**",
    "web/dist/**",
    "web/.output/**",
    "web/coverage/**",
    "internal/httpserver/webdist/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "**/node_modules/**",
    "**/.cache/**",
    "**/tmp/**",
    "**/temp/**",
    "**/*.min.*",
    "**/*.map",
    "**/*.lock",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/go.sum",
    "**/vendor/**",
    "**/*.gen.go",
    "**/*.pb.go",
    "**/*_generated.go",
    "**/__generated__/**",
    "**/generated/**",
    "web/src/api/generated/**",
    "web/openapi.json",
    "web/typed-router.d.ts",
    "web/src/components/ui/**",
    "**/*_test.go",
    "**/*_test.ts",
    "**/*_test.tsx",
    "**/*_test.vue",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.vue"
  ],
  "ignorePattern": [
    "**/.git/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/.dev/**",
    "**/bin/**",
    "web/dist/**",
    "web/.output/**",
    "web/coverage/**",
    "internal/httpserver/webdist/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "**/node_modules/**",
    "**/.cache/**",
    "**/tmp/**",
    "**/temp/**",
    "**/*.min.*",
    "**/*.map",
    "**/*.lock",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/go.sum",
    "**/vendor/**",
    "**/*.gen.go",
    "**/*.pb.go",
    "**/*_generated.go",
    "**/__generated__/**",
    "**/generated/**",
    "web/src/api/generated/**",
    "web/openapi.json",
    "web/typed-router.d.ts",
    "web/src/components/ui/**",
    "**/*_test.go",
    "**/*_test.ts",
    "**/*_test.tsx",
    "**/*_test.vue",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.vue"
  ]
}
