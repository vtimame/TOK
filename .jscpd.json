{
  "path": [
    "cmd",
    "internal",
    "web/src",
    "web/kubb.config.ts",
    "web/vite.config.ts"
  ],
  "format": [
    "go",
    "typescript",
    "javascript",
    "vue",
    "css"
  ],
  "reporters": [
    "console"
  ],
  "minLines": 8,
  "minTokens": 100,
  "threshold": 5,
  "mode": "mild",
  "absolute": false,
  "gitignore": true,
  "ignore": [
    "**/.git/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/.dev/**",
    "**/bin/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.cache/**",
    "**/tmp/**",
    "**/temp/**",
    "**/*.min.*",
    "**/*.map",
    "**/*.lock",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/go.sum",
    "**/vendor/**",
    "**/*.gen.go",
    "**/*.pb.go",
    "**/*_generated.go",
    "**/__generated__/**",
    "**/generated/**",
    "web/openapi.json",
    "web/src/api/generated/**",
    "web/src/components/ui/**",
    "web/typed-router.d.ts"
  ],
  "ignorePattern": [
    "**/.git/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/.dev/**",
    "**/bin/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.cache/**",
    "**/tmp/**",
    "**/temp/**",
    "**/*.min.*",
    "**/*.map",
    "**/*.lock",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/go.sum",
    "**/vendor/**",
    "**/*.gen.go",
    "**/*.pb.go",
    "**/*_generated.go",
    "**/__generated__/**",
    "**/generated/**",
    "web/openapi.json",
    "web/src/api/generated/**",
    "web/src/components/ui/**",
    "web/typed-router.d.ts"
  ]
}
